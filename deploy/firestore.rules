rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each player owns their own profile. Any signed-in user can read the ladder.
    match /profiles/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Duels: readable by any signed-in user; created by the challenger (player "a");
    // updated by either participant while the match runs. `winner` is write-once:
    // the first client to set it decides the match, and no one can flip it after.
    match /duels/{id} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.a.uid == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.a.uid == request.auth.uid
                        || resource.data.b.uid == request.auth.uid)
                    && (resource.data.winner == null
                        || request.resource.data.winner == resource.data.winner);
    }

    // Quick-match queue: each player writes only their own entry; any signed-in
    // player may read the queue and delete an entry once a match is formed.
    match /matchmaking/{uid} {
      allow read:            if request.auth != null;
      allow create, update:  if request.auth != null && request.auth.uid == uid;
      allow delete:          if request.auth != null;
    }
  }
}
